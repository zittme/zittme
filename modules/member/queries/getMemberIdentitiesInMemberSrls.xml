<?xml version="1.0" encoding="utf-8"?>
<query id="getMemberIdentitiesInMemberSrls" action="select">
	<tables>
		<table name="member_identity" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="in" column="member_srl" var="member_srls" notnull="notnull" />
	</conditions>
</query>
