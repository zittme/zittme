<?xml version="1.0" encoding="utf-8"?>
<query id="updateMemberIdentity" action="update">
	<tables>
		<table name="member_identity" />
	</tables>
	<columns>
		<column name="provider" var="provider" />
		<column name="ci" var="ci" />
		<column name="di" var="di" />
		<column name="name" var="name" />
		<column name="birthday" var="birthday" />
		<column name="sex" var="sex" />
		<column name="phone" var="phone" />
		<column name="telecom" var="telecom" />
		<column name="tid" var="tid" />
		<column name="regdate" var="regdate" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" notnull="notnull" filter="number" />
	</conditions>
</query>
