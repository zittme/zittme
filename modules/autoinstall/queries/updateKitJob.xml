<query id="updateKitJob" action="update">
	<tables>
		<table name="autoinstall_kit_jobs" />
	</tables>
	<columns>
		<column name="options" var="options" />
		<column name="state" var="state" />
		<column name="status" var="status" />
		<column name="message" var="message" />
		<column name="last_update" var="last_update" default="curdate()" />
	</columns>
	<conditions>
		<condition operation="equal" column="job_srl" var="job_srl" filter="number" notnull="notnull" />
	</conditions>
</query>
