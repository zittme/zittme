<query id="insertKitItem" action="insert">
	<tables>
		<table name="autoinstall_kit_items" />
	</tables>
	<columns>
		<column name="item_srl" var="item_srl" filter="number" notnull="notnull" />
		<column name="job_srl" var="job_srl" filter="number" notnull="notnull" />
		<column name="kind" var="kind" notnull="notnull" />
		<column name="ref" var="ref" default="" />
		<column name="target" var="target" default="" />
		<column name="before_value" var="before_value" />
		<column name="regdate" var="regdate" default="curdate()" />
	</columns>
</query>
