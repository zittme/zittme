<!--
  스킨 값이 특정 문자열로 시작하는 모듈을 찾는다.
  테마를 지우기 전에 "이 테마를 지금 쓰고 있는 곳"을 확인하는 데 쓴다.
-->
<query id="getModuleListBySkin" action="select">
    <tables>
        <table name="modules" />
    </tables>
    <columns>
        <column name="module_srl" />
        <column name="mid" />
        <column name="module" />
        <column name="site_srl" />
        <column name="domain_srl" />
        <column name="skin" />
        <column name="mskin" />
    </columns>
    <conditions>
        <group>
            <condition operation="like_prefix" column="skin" var="s_skin" />
            <condition operation="like_prefix" column="mskin" var="s_mskin" pipe="or" />
        </group>
    </conditions>
</query>
