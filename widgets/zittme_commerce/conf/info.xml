			<options><value>N</value><name xml:lang="ko">감춤</name><name xml:lang="en">Hide</name><name xml:lang="ja">表示しない</name><name xml:lang="vi">Ẩn</name><name xml:lang="es">Ocultar</name><name xml:lang="zh-TW">隱藏</name></options>
			<options><value>Y</value><name xml:lang="ko">보임</name><name xml:lang="en">Show</name><name xml:lang="ja">表示する</name><name xml:lang="vi">Hiện</name><name xml:lang="es">Mostrar</name><name xml:lang="zh-TW">顯示</name></options>
