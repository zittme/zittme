			<options><value>Y</value><name xml:lang="ko">가격 옆 빨간 글씨</name><name xml:lang="en">Next to the price, in red</name><name xml:lang="ja">価格の横に赤字で</name><name xml:lang="vi">Cạnh giá, chữ đỏ</name><name xml:lang="es">Junto al precio, en rojo</name><name xml:lang="zh-TW">價格旁紅字</name></options>
		</var>
		<var id="show_grade_price" type="select">
			<name xml:lang="ko">회원 등급가 표시</name>
			<name xml:lang="en">Member grade price</name>
			<name xml:lang="ja">会員等級価格の表示</name>
			<name xml:lang="vi">Hiển thị giá theo hạng thành viên</name>
			<name xml:lang="es">Precio por nivel de miembro</name>
			<name xml:lang="zh-TW">顯示會員等級價</name>
			<description xml:lang="ko">커머스에서 등급 할인을 쓰는 경우, 로그인한 회원에게 등급 할인이 적용된 가격을 보여 줍니다.</description>
			<description xml:lang="en">If the shop uses grade discounts, logged-in members see the price with their grade discount applied.</description>
			<description xml:lang="ja">ショップで等級割引を使う場合、ログイン中の会員に等級割引後の価格を表示します。</description>
			<description xml:lang="vi">Nếu cửa hàng dùng giảm giá theo hạng, thành viên đã đăng nhập sẽ thấy giá sau khi giảm.</description>
			<description xml:lang="es">Si la tienda usa descuentos por nivel, los miembros con sesión iniciada ven el precio con su descuento.</description>
