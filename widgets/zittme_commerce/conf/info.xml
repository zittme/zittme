<?xml version="1.0" encoding="UTF-8"?>
<widget version="0.2">
	<title xml:lang="ko">통합 커머스 위젯</title>
	<title xml:lang="en">Unified Commerce Widget</title>
	<description xml:lang="ko">
		쇼핑몰 상품을 메인 페이지나 어느 페이지에든 꺼내 전시합니다.
		신상품, 인기, 할인, 추천, 분류, 기획전, 직접 지정 중에서 기준만 정해 두면 상품이 바뀔 때 화면도 알아서 바뀝니다.
		격자, 가로 넘김, 목록, 큰 카드, 분류 탭 중에서 전시 형태를 고르고, 한 줄을 최대 4칸으로 나눠 칸마다 다른 상품을 둘 수 있습니다.
		화면 크기에 맞춰 배치가 자동으로 바뀝니다.
	</description>
	<description xml:lang="en">
		Puts shop products on your front page, or any page.
		Choose what to show once - newest, popular, on sale, recommended, a category, a promotion, or specific items - and the page keeps itself up to date.
		Pick a display: grid, carousel, list, feature card, or category tabs. One row can be split into up to four slots, each showing something different.
	</description>
	<version>0.2.1</version>
	<date>2026-09-15</date>
	<author email_address="contact@zzan.me" link="https://zzan.me/">
		<name xml:lang="ko">ZZAN Studio</name>
		<name xml:lang="en">ZZAN Studio</name>
	</author>
	<extra_vars>
		<var id="preset" type="select">
			<name xml:lang="ko">줄 구성</name>
			<name xml:lang="en">Row layout</name>
			<description xml:lang="ko">한 줄을 어떻게 나눌지 고릅니다. 직접 구성을 고르면 아래 비율과 슬롯 설정을 씁니다.</description>
			<description xml:lang="en">Choose how this row is split. Pick Custom to use the ratio and slot settings below.</description>
			<options><value>grid4</value><name xml:lang="ko">격자 - 가로 4칸</name><name xml:lang="en">Grid, 4 across</name></options>
			<options><value>grid3</value><name xml:lang="ko">격자 - 가로 3칸</name><name xml:lang="en">Grid, 3 across</name></options>
			<options><value>carousel</value><name xml:lang="ko">가로 넘김 (한 줄 전체)</name><name xml:lang="en">Carousel</name></options>
			<options><value>feature_grid</value><name xml:lang="ko">큰 카드 + 격자</name><name xml:lang="en">Feature + grid</name></options>
			<options><value>grid_list</value><name xml:lang="ko">격자 + 목록</name><name xml:lang="en">Grid + list</name></options>
			<options><value>list_list</value><name xml:lang="ko">목록 + 목록</name><name xml:lang="en">List + list</name></options>
			<options><value>tab_grid</value><name xml:lang="ko">탭 + 격자</name><name xml:lang="en">Tabs + grid</name></options>
			<options><value>grid3col</value><name xml:lang="ko">격자 3덩어리</name><name xml:lang="en">Three grids</name></options>
			<options><value>custom</value><name xml:lang="ko">직접 구성</name><name xml:lang="en">Custom</name></options>
		</var>
		<var id="columns" type="text">
			<name xml:lang="ko">직접 구성 비율</name>
			<name xml:lang="en">Custom ratio</name>
			<description xml:lang="ko">줄 구성이 "직접 구성"일 때만 씁니다. 예: 50:50 또는 60:40 또는 34:33:33</description>
			<description xml:lang="en">Used only with Custom. Example: 50:50 or 60:40 or 34:33:33</description>
		</var>
		<var id="carousel_auto" type="select">
			<name xml:lang="ko">가로 넘김 자동 흐름</name>
			<name xml:lang="en">Carousel autoplay</name>
			<description xml:lang="ko">가로 넘김 전시에서 상품이 저절로 흘러가게 합니다. 마우스를 올리면 멈춥니다.</description>
			<description xml:lang="en">Let the carousel scroll by itself. It pauses on hover.</description>
			<options><value>N</value><name xml:lang="ko">사용 안 함</name><name xml:lang="en">Off</name></options>
			<options><value>Y</value><name xml:lang="ko">사용</name><name xml:lang="en">On</name></options>
		</var>
		<var id="carousel_speed" type="select">
			<name xml:lang="ko">흐르는 속도</name>
			<name xml:lang="en">Scroll speed</name>
			<options><value>slow</value><name xml:lang="ko">느리게</name><name xml:lang="en">Slow</name></options>
			<options><value>normal</value><name xml:lang="ko">보통</name><name xml:lang="en">Normal</name></options>
			<options><value>fast</value><name xml:lang="ko">빠르게</name><name xml:lang="en">Fast</name></options>
		</var>
		<var id="new_hours" type="text">
