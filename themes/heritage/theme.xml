<?xml version="1.0" encoding="UTF-8"?>
<!--
  Heritage : XE 시절 기본 레이아웃(NAVER 제작)의 구조를 물려받아 다시 지은 테마.
  구조(GNB 2뎁스 · 서브 LNB · 비주얼 슬라이더 · 960 그리드의 흐름)는 그대로 두고,
  겉모습만 현재 디자인 언어(hr 토큰 · 반응형 · 다크 모드)로 새로 썼다.
  (XML 주석에는 이중 하이픈을 쓸 수 없다. 토큰 표기를 여기 적을 때 주의)
-->
<theme schema="1.0">
	<title xml:lang="ko">헤리티지</title>
	<title xml:lang="en">Heritage</title>
	<description xml:lang="ko">NAVER가 만든 XE 시절 기본 레이아웃을 최신 트렌드에 맞춰 리마스터했습니다. 상단 2뎁스 메뉴·비주얼 슬라이더·서브 LNB 같은 원본의 구성은 그대로 물려받되, 코드는 템플릿 v2로 새로 쓰고 디자인은 지금 기준으로 다시 해석했습니다. 레이아웃과 게시판·회원·커머스·예약·짓미페이 스킨이 한 벌로 맞춰져 있습니다.</description>
	<description xml:lang="en">A remaster of the classic XE default layout originally built by NAVER. The structure — two-depth GNB, visual slider, sub LNB — is inherited, while the markup is rewritten on template v2 and the design reinterpreted for today. Layout plus board, member, commerce, reservation and Zittme Pay skins ship as one matched set.</description>
	<version>1.0.9</version>
	<date>2026-08-25</date>
	<author email_address="zittme-contact@zzan.me" link="https://zitt.me">ZZAN Studio</author>
	<license>GPLv2</license>

	<components>
		<component type="layout" name="heritage_default" />
		<component type="module-skin" target="board" name="heritage_default" />
		<component type="module-skin" target="member" name="heritage_default" />
		<!-- 아래 넷은 해당 모듈이 설치된 사이트에서만 적용된다 -->
		<component type="module-skin" target="commerce" name="heritage_default" />
		<component type="module-skin" target="reservation" name="heritage_default" />
		<component type="module-skin" target="zittme_pay" name="heritage_default" />
		<component type="module-skin" target="contact" name="heritage_default" />
		<component type="module-skin" target="kin" name="heritage_default" />
	</components>

	<apply>
		<layout name="heritage_default" />
		<skin module="board" name="heritage_default" />
		<skin module="member" name="heritage_default" />
		<skin module="commerce" name="heritage_default" />
		<skin module="reservation" name="heritage_default" />
		<skin module="zittme_pay" name="heritage_default" />
		<skin module="contact" name="heritage_default" />
	</apply>
</theme>
