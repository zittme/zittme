<?xml version="1.0" encoding="UTF-8"?>
<theme schema="1.0">
	<title xml:lang="ko">헤리티지 XEDITION</title>
	<title xml:lang="en">Heritage XEDITION</title>
	<description xml:lang="ko">헤리티지 테마를 기반으로 XE 시절 XEDITION 레이아웃의 디자인을 되살린 테마입니다. 골드 포인트 컬러와 다크 그레이 조합, 클래식 테이블형 게시판 등 XEDITION 특유의 무드를 현재 코드 기준(템플릿 v2 · 반응형 · 다크 모드)으로 재해석했습니다. 레이아웃과 게시판·회원·커머스·예약·짓미페이 스킨이 한 벌로 맞춰져 있습니다.</description>
	<description xml:lang="en">A Heritage-based theme that revives the design of the classic XEDITION layout: gold accent with dark gray, classic table-style board and the rest of the XEDITION mood, reinterpreted on today's codebase (template v2, responsive, dark mode). Layout plus board, member, commerce, reservation and Zittme Pay skins ship as one matched set.</description>
	<version>1.0.5</version>
	<date>2026-08-31</date>
	<author email_address="zittme-contact@zzan.me" link="https://zitt.me">ZZAN Studio</author>
	<license>GPLv2</license>

	<components>
		<component type="layout" name="heritage_xedition" />
		<component type="module-skin" target="board" name="heritage_xedition" />
		<component type="module-skin" target="member" name="heritage_xedition" />
		<!-- 아래 항목은 해당 모듈이 설치된 사이트에서만 적용된다 -->
		<component type="module-skin" target="commerce" name="heritage_xedition" />
		<component type="module-skin" target="reservation" name="heritage_xedition" />
		<component type="module-skin" target="zittme_pay" name="heritage_xedition" />
		<component type="module-skin" target="contact" name="heritage_xedition" />
		<component type="module-skin" target="kin" name="heritage_xedition" />
		<component type="module-skin" target="communication" name="heritage_xedition" />
	</components>

	<apply>
		<layout name="heritage_xedition" />
		<skin module="board" name="heritage_xedition" />
		<skin module="member" name="heritage_xedition" />
		<skin module="commerce" name="heritage_xedition" />
		<skin module="reservation" name="heritage_xedition" />
		<skin module="zittme_pay" name="heritage_xedition" />
		<skin module="contact" name="heritage_xedition" />
		<skin module="communication" name="heritage_xedition" />
	</apply>
</theme>
